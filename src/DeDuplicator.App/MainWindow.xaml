<Window x:Class="DeDuplicator.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DeDuplicator" Width="1320" Height="860" MinWidth="980" MinHeight="650">
<Grid Background="#F3F6F8"><Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#142F3D" Padding="24"><DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Top"><TextBlock Text="DeDuplicator" Foreground="White" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="EXACT FILE COMPARISON" Foreground="#8FB4C3" FontSize="10" Margin="0,8,0,40"/><TextBlock Text="Your files. Your decision." Foreground="White" FontSize="16" TextWrapping="Wrap"/><TextBlock Text="Compare complete contents, choose a keeper, then review every change." Foreground="#B4CCD6" TextWrapping="Wrap" Margin="0,14,0,32"/><TextBlock Text="01   Choose locations&#10;&#10;02   Scan and verify&#10;&#10;03   Review copies&#10;&#10;04   Plan and quarantine" Foreground="#D2E3EB"/><Separator Margin="0,30"/><TextBlock Text="LOCAL BY DESIGN" Foreground="#8FB4C3" FontSize="11"/><TextBlock Text="No uploads. No telemetry.&#10;No administrator access." Foreground="#B4CCD6" TextWrapping="Wrap" Margin="0,10"/></StackPanel></DockPanel></Border>
<Grid Grid.Column="1" Margin="26,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Make room for what matters." FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Find identical bytes across different names and locations." Foreground="#526B7A" Margin="0,7,0,20"/></StackPanel>
<Border Grid.Row="1" Background="White" Padding="16" Margin="0,0,0,16" CornerRadius="8"><StackPanel><TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding ProgressText}" Foreground="#526B7A" Margin="0,6" TextWrapping="Wrap"/><ProgressBar Height="3" IsIndeterminate="{Binding Busy}"/><WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0"><Button Content="Scan and verify" Command="{Binding Scan}" Background="#14695F" Foreground="White"/><Button Content="Cancel current operation" Command="{Binding Cancel}"/></WrapPanel></StackPanel></Border>
<ScrollViewer x:Name="WorkflowScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Workflow scroll area">
<TabControl MinHeight="460" Height="{Binding ViewportHeight, ElementName=WorkflowScroll}" SelectedIndex="{Binding Tab}">
<TabItem Header=" Locations &amp; settings "><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
<TextBlock Text="Where should we look?" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="One folder or drive per line. Overlapping locations are scanned once." Margin="0,8"/>
<TextBox Text="{Binding Roots, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="95" AutomationProperties.Name="Selected scan locations"/>
<WrapPanel><Button Content="Add folder…" Command="{Binding AddFolder}"/><Button Content="Load profile…" Command="{Binding LoadProfile}"/><Button Content="Save profile…" Command="{Binding SaveProfile}"/></WrapPanel>
<WrapPanel><CheckBox Content="Include empty files" IsChecked="{Binding IncludeEmpty}"/><CheckBox Content="Include hidden files" IsChecked="{Binding IncludeHidden}"/><CheckBox Content="Include system files" IsChecked="{Binding IncludeSystem}"/><CheckBox Content="Allow network locations" IsChecked="{Binding AllowNetwork}"/><CheckBox Content="Allow cloud hydration" IsChecked="{Binding AllowCloud}"/><CheckBox Content="Use sample filter" IsChecked="{Binding Sample}"/></WrapPanel>
<TextBlock Text="Minimum / maximum bytes (empty maximum means unlimited)"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Text="{Binding Minimum}" AutomationProperties.Name="Minimum file bytes" Margin="0,4,10,10"/><TextBox Grid.Column="1" Text="{Binding Maximum}" AutomationProperties.Name="Maximum file bytes"/></Grid>
<TextBlock Text="Included extensions, comma separated (empty means all)"/><TextBox Text="{Binding IncludedExtensions}" AutomationProperties.Name="Included extensions"/>
<TextBlock Text="Excluded extensions, comma separated"/><TextBox Text="{Binding ExcludedExtensions}" AutomationProperties.Name="Excluded extensions"/>
<TextBlock Text="Excluded folders, one per line"/><TextBox Text="{Binding Exclusions}" AcceptsReturn="True" Height="65" AutomationProperties.Name="Excluded folders"/>
<TextBlock Text="Protected folders, one per line (never automatically selected)"/><TextBox Text="{Binding Protections}" AcceptsReturn="True" Height="65" AutomationProperties.Name="Protected folders"/>
<TextBlock Text="Conservative I/O: one file read at a time. Links and junctions are skipped. Whole-drive scans may encounter inaccessible folders." TextWrapping="Wrap" Foreground="#526B7A" Margin="0,6,0,16"/>
<Button Content="Scan and verify" Command="{Binding Scan}" Background="#14695F" Foreground="White" HorizontalAlignment="Left"/>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header=" Duplicate groups "><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<WrapPanel><TextBox Text="{Binding Search}" Width="200" AutomationProperties.Name="Search result paths"/><ComboBox ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}" Width="120" AutomationProperties.Name="Sort groups"/><Button Content="Filter / refresh" Command="{Binding Refresh}"/><Button Content="Previous" Command="{Binding Previous}"/><Button Content="Next" Command="{Binding Next}"/><Button Content="Export…" Command="{Binding Export}"/></WrapPanel>
<WrapPanel Grid.Row="1"><ComboBox ItemsSource="{Binding Rules}" SelectedItem="{Binding Rule}" Width="160" AutomationProperties.Name="Keeper selection rule"/><TextBox Text="{Binding Preferred}" Width="190" ToolTip="Preferred directory for the location rule" AutomationProperties.Name="Preferred keeper directory"/><Button Content="Propose selections" Command="{Binding SelectRule}"/><Button Content="Review action plan →" Command="{Binding Review}"/></WrapPanel>
<DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutomationProperties.Name="Duplicate file results"><DataGrid.Columns>
<DataGridTextColumn Header="Group" Binding="{Binding GroupId}" IsReadOnly="True" Width="65"/>
<DataGridCheckBoxColumn Header="Remove?" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
<DataGridTextColumn Header="File / full path" Binding="{Binding File.Path}" IsReadOnly="True" Width="*" MinWidth="300"/>
<DataGridTextColumn Header="Bytes" Binding="{Binding File.Length}" IsReadOnly="True" Width="95"/>
<DataGridTextColumn Header="Modified UTC" Binding="{Binding File.ModifiedUtc, StringFormat=yyyy-MM-dd HH:mm}" IsReadOnly="True" Width="140"/>
<DataGridTextColumn Header="Safety" Binding="{Binding Safety}" IsReadOnly="True" Width="130"/>
</DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="3"><TextBlock Text="{Binding PageText}" Margin="0,8" TextWrapping="Wrap"/><WrapPanel><Button Content="Keep selected copy" Command="{Binding KeepSelected}"/><Button Content="Previous copies" Command="{Binding PreviousMembers}"/><Button Content="More copies" Command="{Binding NextMembers}"/><Button Content="Open file…" Command="{Binding OpenFile}"/><Button Content="Show folder" Command="{Binding OpenFolder}"/><Button Content="Copy path" Command="{Binding CopyPath}"/></WrapPanel><TextBlock Text="Identical primary content can have different permissions or extra streams. Cleanup revalidates every copy. Logical duplicate bytes are not a disk-space promise." TextWrapping="Wrap" Foreground="#526B7A"/></StackPanel>
</Grid></TabItem>
<TabItem Header=" Action plan "><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Review before changing files" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Quarantine is recommended. Same-volume quarantine retains storage. Cross-volume copies are verified before the source is removed. Batches can partially complete." TextWrapping="Wrap" Margin="0,8"/><TextBlock Text="Quarantine folder"/><TextBox Text="{Binding Quarantine}" AutomationProperties.Name="Quarantine destination"/><WrapPanel><ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}" Width="190" AutomationProperties.Name="Cleanup action"/><CheckBox Content="Enable advanced permanent deletion" IsChecked="{Binding PermanentEnabled}"/></WrapPanel></StackPanel>
<Button Grid.Row="1" Content="Rebuild plan from reviewed selections" Command="{Binding Review}" HorizontalAlignment="Left"/>
<DataGrid Grid.Row="2" ItemsSource="{Binding PlanRows}" IsReadOnly="True" AutomationProperties.Name="Reviewable cleanup plan"><DataGrid.Columns><DataGridTextColumn Header="Source" Binding="{Binding Source.Path}" Width="2*" MinWidth="220"/><DataGridTextColumn Header="Retained keeper" Binding="{Binding Keeper.Path}" Width="2*" MinWidth="220"/><DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="100"/><DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="2*" MinWidth="220"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*" MinWidth="220"/></DataGrid.Columns><DataGrid.RowDetailsTemplate><DataTemplate><StackPanel Margin="12"><TextBlock Text="{Binding Source.Path, StringFormat=Source: {0}}" TextWrapping="Wrap"/><TextBlock Text="{Binding Keeper.Path, StringFormat=Keep: {0}}" TextWrapping="Wrap"/><TextBlock Text="{Binding Destination, StringFormat=Destination: {0}}" TextWrapping="Wrap"/><TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/></StackPanel></DataTemplate></DataGrid.RowDetailsTemplate></DataGrid>
<StackPanel Grid.Row="3"><TextBlock Text="{Binding PlanText}" Margin="0,10" TextWrapping="Wrap"/><Button Content="Execute reviewed plan…" Command="{Binding Execute}" Background="#14695F" Foreground="White" HorizontalAlignment="Left"/></StackPanel>
</Grid></TabItem>
<TabItem Header=" History &amp; recovery "><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<WrapPanel><Button Content="Refresh history / journal" Command="{Binding RefreshHistory}"/><Button Content="View historical scan" Command="{Binding ViewHistory}"/><Button Content="Rescan historical profile" Command="{Binding ResumeHistory}"/></WrapPanel>
<ListBox Grid.Row="1" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" DisplayMemberPath="Label" AutomationProperties.Name="Scan history"/>
<TextBlock Grid.Row="2" Text="Operation journal — interrupted entries require inspection of both paths; no automatic retry." TextWrapping="Wrap" Margin="0,14"/>
<DataGrid Grid.Row="3" ItemsSource="{Binding Journal}" SelectedItem="{Binding SelectedJournal}" IsReadOnly="True" AutomationProperties.Name="Cleanup recovery journal"><DataGrid.Columns><DataGridTextColumn Header="Original" Binding="{Binding Source}" Width="*" MinWidth="250"/><DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="*" MinWidth="250"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="150"/><DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*" MinWidth="250"/></DataGrid.Columns><DataGrid.RowDetailsTemplate><DataTemplate><StackPanel Margin="12"><TextBlock Text="{Binding Source}" TextWrapping="Wrap"/><TextBlock Text="{Binding Destination}" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/></StackPanel></DataTemplate></DataGrid.RowDetailsTemplate></DataGrid>
<Button Grid.Row="4" Content="Restore selected quarantine entry…" Command="{Binding Restore}" HorizontalAlignment="Left" Margin="0,12"/>
</Grid></TabItem>
</TabControl>
</ScrollViewer>
<Expander Grid.Row="3" Header="Activity and scan issues" Margin="0,12,0,0"><TextBox Text="{Binding Details}" IsReadOnly="True" AcceptsReturn="True" MaxHeight="150" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Operation and scan details"/></Expander>
</Grid></Grid></Window>
